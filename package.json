{
  "name": "arbeitmgmt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "prepare:runtime": "node scripts/prepare-runtime.js",
    "dev": "node scripts/serve.js",
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build.js",
    "preview": "node scripts/serve.js dist",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && node scripts/android-build.js",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/core": "8.5.3",
    "pdfmake": "0.2.20",
    "pdfjs-dist": "5.4.296"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@foliojs-fork/fontkit": "1.9.2",
    "@playwright/test": "1.56.1"
  }
}
